# Anthropic API key used by the extraction pipeline.
# Get one at https://console.anthropic.com — a full corpus run costs about $2.30.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string (pipeline/schema.sql).
# Not required to run the pipeline or the UI; used for fact-level drill-down.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
